{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "deny": [
            "Read(~/**)",
            "Edit(~/**)",
            "Bash(cd .. *)",
            "Bash(cd ../*)",
            "Read(**/bin/**)",
            "Edit(**/bin/**)",
            "Read(**/obj/**)",
            "Edit(**/obj/**)",
            "Read(**/build/**)",
            "Edit(**/build/**)",
            "Read(**/dist/**)",
            "Edit(**/dist/**)",
            "Read(**/out/**)",
            "Edit(**/out/**)",
            "Read(**/lib/**)",
            "Edit(**/lib/**)",
            "Read(**/.vs/**)",
            "Edit(**/.vs/**)",
            "Read(**/*.user)",
            "Edit(**/*.user)",
            "Read(**/backups/**)",
            "Edit(**/backups/**)",
            "Read(**/appsettings.json)",
            "Edit(**/appsettings.json)",
            "Read(**/appsettings.Development.json)",
            "Edit(**/appsettings.Development.json)",
            "Read(**/appsettings.Production.json)",
            "Edit(**/appsettings.Production.json)",
            "Read(**/launchSettings.json)",
            "Edit(**/launchSettings.json)",
            "Read(**/.env)",
            "Edit(**/.env)",
            "Read(**/.env.local)",
            "Edit(**/.env.local)",
            "Read(**/.env.development.local)",
            "Edit(**/.env.development.local)",
            "Read(**/.env.test.local)",
            "Edit(**/.env.test.local)",
            "Read(**/.env.production.local)",
            "Edit(**/.env.production.local)",
            "Read(**/.env.development)",
            "Edit(**/.env.development)",
            "Read(**/.env.test)",
            "Edit(**/.env.test)",
            "Read(**/.env.production)",
            "Edit(**/.env.production)"
        ]
    }
}
